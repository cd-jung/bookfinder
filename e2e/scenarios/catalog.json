{
  "_comment": "BookFinder E2E scenario catalog, from poc_samples/e2e/scenarios/catalog.json. The chatbot is the User Guide Help assistant (RAG over docs/user-guide); catalogue-chat scenarios DET-007, CHAT-008, CHAT-010, GRD-004 and SAFE-003 were removed. Journeys 8-10 come from the project template. Edit together with ux-flows and e2e/tests (AGENTS.md).",
  "_priority_rules": {
    "_how_to_apply": "A scenario is 'core' if at least one core rule applies; otherwise it is 'secondary'. Record the deciding rule in 'rule' (the core rule wins when several apply).",
    "core": {
      "C1": "Page availability - the page and each main section (search, results, detail, chat) load without error.",
      "C2": "Search correctness - keyword, filters and natural language search return exactly the books that match.",
      "C3": "Grounded answers - the chatbot answers only from the catalogue, cites existing books, and says so when it does not know.",
      "C4": "AI safety & guard rails - generated filters are validated, prompt injection / out-of-scope / personal-data requests are refused, output is rendered safely.",
      "C5": "Failure handling on core paths - backend or LLM failure shows a recoverable message instead of a broken page."
    },
    "secondary": {
      "S1": "In-page UI behaviour - sort, view toggle, chips, pagination, copy, open / close.",
      "S2": "Informational content - counts, badges, tooltips, disclaimers, placeholders.",
      "S3": "Viewport / accessibility variant - mobile layout, keyboard only, screen reader, axe scan.",
      "S4": "Negative / edge input - blank, too long, invalid ranges, special characters.",
      "S5": "Shortcut / URL state - deep links, back / forward, reload restore.",
      "S6": "Feedback & telemetry - thumbs up / down, comments."
    }
  },
  "accounts": {
    "_note": "BookFinder has no login. These are test contexts, not user accounts.",
    "anonymous": "Desktop Chrome, no stored state, real or stubbed backend",
    "anonymous_mobile": "Mobile viewport (Pixel 7)",
    "keyboard": "Desktop, keyboard-only navigation",
    "screen_reader": "Desktop, checks ARIA roles / live regions (axe + role queries)",
    "llm_stub": "Desktop, local stack with LLM_MODE=stub: deterministic NL filters (catalogue examples) and keyword retrieval over the User Guide",
    "llm_down": "Desktop, AI endpoints answer 502 / 503 (Playwright route interception)",
    "api_down": "Desktop, catalogue API answers 5xx (Playwright route interception)",
    "offline": "Desktop, browser network set offline",
    "deployed_real": "Deployed site with Workers AI and Vectorize; runs in CD after deploy (tests tagged @real)"
  },
