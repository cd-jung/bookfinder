{
	// Frontend Worker: serves frontend/dist (app + /reports/coverage.html + /ux-flows/) as static assets.
	// No script: static requests are free and never invoke a Worker.
	"name": "bookfinder", // from project.config.json
	"compatibility_date": "2026-07-29",
	"assets": {
		"directory": "./dist",
		"not_found_handling": "single-page-application"
	}
}
